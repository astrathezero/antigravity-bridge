# Optional: password for noVNC web interface (port 6080)
# REQUIRED: change this before deploying to a server!
NOVNC_PASSWORD=change_this_password

# Number of Chrome windows to open (1–10), one per Google account
CHROME_ACCOUNTS=2

# (Optional) custom URLs per Chrome window, comma-separated
# Leave empty to use defaults: /app, /u/1/app, /u/2/app, ...
# CHROME_URLS=https://gemini.google.com/app,https://gemini.google.com/u/1/app
