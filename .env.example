# ==============================================================================
# Antigravity Bridge Server - Local Environment Configuration (.env)
# ==============================================================================
# Copy this file to '.env' (or '~/.config/antigravity/bridge.env')
# This file is ignored by git, so your private settings will remain safe!
# ==============================================================================

# Network & Binding
ANTIGRAVITY_HOST=127.0.0.1
ANTIGRAVITY_PORT=8000

# Concurrency & Routing
ANTIGRAVITY_PROFILE_CONCURRENCY=1
# ANTIGRAVITY_PROFILES=profile_1,profile_2,profile_3
# ANTIGRAVITY_PROFILE=profile_1

# Security & API Key (Optional)
# ANTIGRAVITY_BRIDGE_API_KEY=sk-your-secret-api-key

# External Image Generation Router (Optional)
# ANTIGRAVITY_IMAGE_ROUTER_URL=https://your-image-router-domain.com/v1
# ANTIGRAVITY_IMAGE_ROUTER_KEY=sk-your-image-router-key

# Google AI Studio API Key for Imagen 3 (Optional)
# GEMINI_API_KEY=AIzaSy...

# Outbound Proxy & Auto-Refresh
# ANTIGRAVITY_NO_PROXY=0
# ANTIGRAVITY_NO_AUTO_REFRESH=0
# ANTIGRAVITY_HIDE_PROFILE_STATUS=0
