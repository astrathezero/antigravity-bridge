{
  "manifest_version": 3,
  "name": "Antigravity Web Bridge",
  "version": "1.0.0",
  "description": "Relays local Antigravity requests through logged-in gemini.google.com sessions with multi-profile and channel management.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Antigravity Web Bridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "offscreen"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://*.google.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page.js"
      ],
      "matches": [
        "https://gemini.google.com/*"
      ]
    }
  ]
}
