# ==============================================================================
# Antigravity Bridge Server - Local Environment Configuration (.env)
# ==============================================================================
# Copy this file to '.env' (or '~/.config/antigravity/bridge.env')
# This file is ignored by git, so your private settings will remain safe!
# ==============================================================================

# Network & Binding
ANTIGRAVITY_HOST=127.0.0.1
ANTIGRAVITY_PORT=8000

# Concurrency & Routing
ANTIGRAVITY_PROFILE_CONCURRENCY=1
# ANTIGRAVITY_PROFILES=profile_1,profile_2,profile_3
# ANTIGRAVITY_PROFILE=profile_1
# ANTIGRAVITY_DISABLED_PROFILES=reserve_profile,backup_profile

# Security & API Key Authentication (Strongly recommended)
# The bridge runs the agy agent with permissions disabled, so an unauthenticated port
# equals remote shell access. Without a key the server still starts (anonymous mode)
# but logs a warning; keep it bound to 127.0.0.1 in that case.
# Generate one with:  python3 antigravity_bridge.py key generate my-agent
#                     node src/index.mjs key generate my-agent
#
# Extra Host header values to accept (loopback + bind host are always allowed).
# Requests with any other Host header get 403 (DNS-rebinding defence).
# ANTIGRAVITY_ALLOWED_HOSTS=bridge.lan,10.0.0.5
#
# CORS is OFF by default (start with --enable-cors only if a browser app must call the bridge).
# Single API Key format:
# ANTIGRAVITY_BRIDGE_API_KEY=sk-your-secret-api-key
#
# Multiple API Keys format with agent labels (e.g. Cursor, Hermes, Cline, Claude Dev):
# ANTIGRAVITY_BRIDGE_API_KEYS=agent-cursor:sk-agv-a1b2c3d4,agent-hermes:sk-agv-e5f6g7h8,team-dev:sk-agv-99887766

# External Image Generation Router (Optional)
# ANTIGRAVITY_IMAGE_ROUTER_URL=https://your-image-router-domain.com/v1
# ANTIGRAVITY_IMAGE_ROUTER_KEY=sk-your-image-router-key

# Google AI Studio API Key for Imagen 3 (Optional)
# GEMINI_API_KEY=AIzaSy...

# Prompt/context budget handed to agy (chars). Tool results are kept in full while the
# conversation fits; only when it exceeds the budget are older tool results compacted.
# Cutting tool results short makes the model re-run the same tool over and over.
# (budget is UTF-8 bytes; Thai text is 3 bytes per character)
# ANTIGRAVITY_MAX_PROMPT_CHARS=200000
# ANTIGRAVITY_RECENT_TOOL_OUTPUT_CHARS=20000
# ANTIGRAVITY_OLD_TOOL_OUTPUT_CHARS=2000
# Prompts above ANTIGRAVITY_MAX_CLI_ARG_BYTES (Linux argv limit is 131072 per argument) are sent
# to agy over stdin as NDJSON (--input-format stream-json) instead of being truncated.
# ANTIGRAVITY_MAX_CLI_ARG_BYTES=120000
# ANTIGRAVITY_MAX_STDIN_PROMPT_BYTES=2000000

# Long-thinking models: agy emits no output while the model thinks. The stall watchdog
# only gives up after this many seconds of silence (default 600). Lower it only if you
# really want fail-fast behaviour on short prompts.
# ANTIGRAVITY_STALL_TIMEOUT=600

# agy is a full agent with its own tools (terminal, files, browser). By default the bridge
# runs in API mode: the prompt tells the model not to use them, and if agy still starts a
# tool step the bridge kills the run immediately and returns an error (otherwise a single
# chat request could execute commands on this machine for 10+ minutes). Set 1 to allow.
# ANTIGRAVITY_ALLOW_CLI_TOOLS=0

# Outbound Proxy & Auto-Refresh
# ANTIGRAVITY_NO_PROXY=0
# ANTIGRAVITY_NO_AUTO_REFRESH=0
# ANTIGRAVITY_HIDE_PROFILE_STATUS=0
