[Unit]
Description=Antigravity / agy OpenAI & Anthropic REST API Bridge Server
After=network.target

[Service]
Type=simple
User=your-username
WorkingDirectory=/home/your-username/antigravity-bridge
ExecStart=/usr/bin/python3 /home/your-username/antigravity-bridge/antigravity_bridge.py --host 127.0.0.1 --port 8000 --profile-concurrency 1
Restart=always
RestartSec=5
Environment=PATH=/home/your-username/.local/bin:/usr/local/bin:/usr/bin:/bin

# Security Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
MemoryMax=2G
TasksMax=256

[Install]
WantedBy=multi-user.target
